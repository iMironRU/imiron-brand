{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "identity",
  "type": "object",
  "required": ["name", "titles", "titleByTarget"],
  "properties": {
    "name": { "type": "string" },
    "shortName": { "type": "string" },
    "handle": { "type": "string" },
    "epigraph": { "type": "string" },
    "core": { "type": "string" },
    "titles": {
      "type": "object",
      "required": ["formal", "portrait", "voice"],
      "properties": {
        "formal": { "type": "string" },
        "portrait": { "type": "string" },
        "voice": { "type": "string" }
      }
    },
    "channelDescription": { "type": "string" },
    "titleByTarget": { "type": "object", "additionalProperties": { "type": "string" } },
    "location": { "type": "object" },
    "since": { "type": "object" }
  }
}
