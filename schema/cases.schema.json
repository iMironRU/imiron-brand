{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cases",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "problem", "solution", "outcome", "targets"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string" },
          "domain": { "type": "string" },
          "period": { "type": "string" },
          "stack": { "type": "array", "items": { "type": "string" } },
          "problem": { "type": "string" },
          "constraint": { "type": "string" },
          "solution": { "type": "string" },
          "outcome": { "type": "string" },
          "lesson": { "type": "string" },
          "targets": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
